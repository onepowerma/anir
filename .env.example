# انسخ هذا الملف باسم .env (محلياً) أو ضع القيم في إعدادات الاستضافة (Environment Variables).
# لا ترفع ملف .env الحقيقي إلى GitHub ولا تشاركه مع أحد.

# ── واتساب (Meta) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
# أي كلمة سرية تختارها أنت، وتكتبها نفسها في إعدادات Webhook عند Meta
WHATSAPP_VERIFY_TOKEN=

# ── Claude ──
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# ── متجر ووكومرس ──
WC_URL=https://onepower.ma
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# ── تنبيهات الموظفين عبر تيليجرام (اختياري لكن موصى به) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

